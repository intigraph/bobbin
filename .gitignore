# Rust build artifacts
/target/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Bobbin index data
.bobbin/

# Docs build output
/docs/book/book/

# Vale synced styles (downloaded by vale sync)
.vale/styles/write-good/

# Python
__pycache__/
*.egg-info/
.venv/
uv.lock

# Eval results (generated per run)
/eval/results/*.json

# Gas Town (added by gt)
.runtime/
.claude/
.logs/

# mdbook build output
# (the root `book/` mdbook tree was deleted 2026-08-25 — it declared a second,
# never-built book while `docs/book` is the one every gate knows about. This
# entry stays: an ignore rule costs nothing and re-adding it after someone
# runs mdbook in the wrong directory costs a commit.)
book/_build/

# Committed runtime state — an operator-path leak (aegis-mqnl). Never track.
/state.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
*.gate.lock*

# Quipu local databases and signing state are never repository source.
/.quipu/
